# Copy to /etc/rootline/edge-relay.env on Board A and fill in your laptop's LAN IP.
LISTEN_ADDR=0.0.0.0:50051
# The payment service, published on the laptop by compose.hardware.yml.
UPSTREAM_ADDR=192.168.1.20:50051
# The snapshotter's OTLP/HTTP port, published by compose.hardware.yml.
OTLP_ENDPOINT=http://192.168.1.20:4318
