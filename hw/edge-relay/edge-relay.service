[Unit]
Description=Rootline edge relay (checkout -> payment over Wi-Fi)
Wants=network-online.target
After=network-online.target

[Service]
EnvironmentFile=/etc/rootline/edge-relay.env
ExecStart=/usr/local/bin/edge-relay
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
