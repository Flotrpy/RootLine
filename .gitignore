# Data: snapshots go to Hugging Face, labels/runs/holdout stay private until release
data/snapshots/*
!data/snapshots/.gitkeep
data/labels/*
!data/labels/.gitkeep
data/runs/*
!data/runs/.gitkeep
data/holdout/
# Scoring queues hold model answers; they live in the private Hugging Face
# work dataset (scripts/score_daily.py), not in git.
data/queue*.sqlite*
# Moved-aside runs (labels included), this machine's image digests, the night log
data/old/
data/image-digests.json
data/overnight.log

# Secrets
.env
.env.*
*.pem

# Go
/bin/
*.test
*.out

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage

# Rust
target/

# Web
node_modules/
.next/
out/

# Editors and local tool settings
.idea/
.vscode/
.DS_Store
.claude/settings.local.json

# Typst and generated figures (rebuilt by `make reproduce` from data/)
paper/*.pdf
paper/figures/

# Derived from snapshots by rootline_harness.export_packs
data/packs/

# Built by `python -m analysis site-data`
web/public/data/
web/public/duckdb/
web/out/
web/.next/

# Release dataset build (published to Hugging Face, not git)
dist/
